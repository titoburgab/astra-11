# Force revalidation on every load for pages/data that change with content updates
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# All HTML pages live in /HTML/. Serve the homepage from there and keep old root URLs working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ /HTML/index.html [L]
  RewriteRule ^(index|about|portfolio|privacy)\.html$ /HTML/$1.html [R=301,L]
</IfModule>
