{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "ASTRA-11 Color Tokens",
    "version": "3.0.0",
    "updated": "2026-08-10",
    "reference": "BRAND_BOOK/Color_System.md"
  },
  "color": {
    "primary": {
      "navy": {
        "$value": "#0A0F1C",
        "$type": "color",
        "$description": "Primary dark background and text on light backgrounds. RGB: 10, 15, 28."
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Primary light background and text on dark backgrounds."
      },
      "orange": {
        "$value": "#FF5100",
        "$type": "color",
        "$description": "Brand accent. Logo underline, CTAs, active states. Do not use for body text below 24px."
      }
    },
    "neutral": {
      "gray": {
        "$value": "#A7ACB3",
        "$type": "color",
        "$description": "Muted/secondary text on dark backgrounds."
      },
      "navy-elevated": {
        "$value": "#121A2C",
        "$type": "color",
        "$description": "Card and panel backgrounds in dark mode."
      },
      "navy-border": {
        "$value": "#1F2A40",
        "$type": "color",
        "$description": "Borders and dividers in dark mode."
      },
      "gray-soft": {
        "$value": "#D7DAE0",
        "$type": "color",
        "$description": "Borders and dividers in light mode."
      },
      "orange-dark": {
        "$value": "#CC4100",
        "$type": "color",
        "$description": "Pressed/hover state for orange on light backgrounds."
      },
      "orange-bright": {
        "$value": "#FF7A33",
        "$type": "color",
        "$description": "Hover state for orange accents on dark backgrounds."
      }
    },
    "semantic": {
      "background-primary-dark": {
        "$value": "{color.primary.navy}",
        "$type": "color",
        "$description": "Primary dark background."
      },
      "background-primary-light": {
        "$value": "{color.primary.white}",
        "$type": "color",
        "$description": "Primary light background."
      },
      "text-primary-on-dark": {
        "$value": "{color.primary.white}",
        "$type": "color",
        "$description": "Primary text on dark backgrounds."
      },
      "text-primary-on-light": {
        "$value": "{color.primary.navy}",
        "$type": "color",
        "$description": "Primary text on light backgrounds."
      },
      "accent": {
        "$value": "{color.primary.orange}",
        "$type": "color",
        "$description": "Brand accent. Use for CTAs, highlights, active states."
      },
      "border-dark": {
        "$value": "{color.neutral.navy-border}",
        "$type": "color",
        "$description": "Border color for dark-mode components."
      },
      "border-light": {
        "$value": "{color.neutral.gray-soft}",
        "$type": "color",
        "$description": "Border color for light-mode components."
      }
    }
  }
}
